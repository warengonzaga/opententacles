{
  "name": "opententacles",
  "version": "0.1.0",
  "description": "A GitHub-native AI agent framework that brings Copilot to every place open-source work happens.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opententacles": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "setup": "bun run src/setup.ts",
    "purge": "bun run src/purge.ts",
    "dev": "bun --hot run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.1.0",
    "@wgtechlabs/config-engine": "^0.1.0",
    "@wgtechlabs/log-engine": "^2.3.1",
    "@wgtechlabs/secrets-engine": "^2.0.0",
    "discord.js": "^14.26.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warengonzaga/opententacles.git"
  },
  "author": "Waren Gonzaga",
  "license": "GPL-3.0"
}
