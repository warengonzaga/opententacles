# ─────────────────────────────────────────────────────────────────────────────
# Open Tentacles — environment variables reference
#
# Copy this file to .env and fill in the values you want to override.
# Bun loads .env automatically in local dev.
#
# NOTE: All of these are optional if you use `bun run setup` instead.
#       Env vars take priority over values stored by the setup wizard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────────────────────

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Discord user ID of the bot owner.
# Required when DISCORD_BOT_TOKEN is set — without this, the bot accepts
# messages from anyone and will burn your Copilot quota. Get your ID via
# Discord → Settings → Advanced → Developer Mode, then right-click your
# username → Copy User ID.
DISCORD_OWNER_ID=

# ── GitHub ────────────────────────────────────────────────────────────────────

# Comma-separated list of GitHub orgs/users you control.
# Used to place cloned repos in first-party paths (e.g. ./warengonzaga/repo)
# instead of ./contribution/warengonzaga/repo. Optional.
GITHUB_NAMESPACES=

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: debug | info | warn | error | silent (default: info)
OPENTENTACLES_LOG_LEVEL=

# ── Storage ───────────────────────────────────────────────────────────────────

# Override the data directory where Open Tentacles persists all state.
# Default: ~/.opententacles
# For Railway: set this to a mounted volume path (e.g. /data)
OPENTENTACLES_DATA_DIR=
