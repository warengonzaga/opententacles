# Managed automatically by `opententacles setup`, or copy for manual setup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opententacles
OPENTENTACLES_APP_URL=http://localhost:3000
OPENTENTACLES_ENCRYPTION_KEY=
OPENTENTACLES_SESSION_KEY=

# Only needed when running a single service manually
OPENTENTACLES_SERVICE=web

# Harness service only: fine-grained token with Copilot Requests and selected repos
COPILOT_GITHUB_TOKEN=
